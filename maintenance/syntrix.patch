--- a/libs/portable/src/main.rs
+++ b/libs/portable/src/main.rs
@@ -25,16 +25,20 @@ const APPNAME_RUNTIME_ENV_KEY: &str = "RUSTDESK_APPNAME";
 #[cfg(windows)]
 const SET_FOREGROUND_WINDOW_ENV_KEY: &str = "SET_FOREGROUND_WINDOW";
 
-// The extraction directory follows whatever executable the payload asks for, so a
-// custom client gets its own directory instead of sharing RustDesk's. Falls back to
-// APP_PREFIX when no package is injected, which keeps stock builds unchanged.
+// Custom payloads keep their own directory. The standard Windows payload uses
+// a separate directory so the SYNTRIX launcher cannot replace RustDesk's cache.
 fn app_dir_name(exe: &str) -> String {
-    Path::new(&exe.replace('\\', "/"))
+    let name = Path::new(&exe.replace('\\', "/"))
         .file_stem()
         .and_then(|stem| stem.to_str())
         .map(|stem| stem.trim().to_lowercase())
         .filter(|stem| !stem.is_empty())
-        .unwrap_or_else(|| APP_PREFIX.to_owned())
+        .unwrap_or_else(|| APP_PREFIX.to_owned());
+    if cfg!(windows) && name == APP_PREFIX {
+        "syntrix-remote".to_owned()
+    } else {
+        name
+    }
 }
 
